generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  student
  teacher
  admin
}

enum AccountStatus {
  PENDING
  ACTIVE
  REJECTED
}

enum NotificationType {
  chat
  material
}

model User {
  id             Int           @id @default(autoincrement())
  username       String        @unique
  password       String
  name           String
  role           Role
  status         AccountStatus @default(ACTIVE)
  rejectReason   String?
  avatarUrl      String?
  avatarPublicId String?
  isOnline       Boolean       @default(false)
  kelas          Int?
  gender         String?
  frameColor     String?       @default("#00B5D8")
  nip            String?
  subject        String?
  colorTheme     String?       @default("#2B569A")
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  studentChatRooms ChatRoom[]     @relation("StudentChatRooms")
  teacherChatRooms ChatRoom[]     @relation("TeacherChatRooms")
  sentMessages     Message[]      @relation("UserMessages")
  notifications    Notification[]
  quizScores       QuizScore[]
}

model ChatRoom {
  id              Int       @id @default(autoincrement())
  studentId       Int
  teacherId       Int
  theme           String    @default("default")
  isImportant     Boolean   @default(false)
  hiddenByTeacher Boolean   @default(false)
  hiddenByStudent Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  student User      @relation("StudentChatRooms", fields: [studentId], references: [id], onDelete: Cascade)
  teacher User      @relation("TeacherChatRooms", fields: [teacherId], references: [id], onDelete: Cascade)
  messages Message[]

  @@unique([studentId, teacherId])
}

model Message {
  id              Int       @id @default(autoincrement())
  chatRoomId      Int
  senderId        Int
  text            String?   @db.Text
  imageUrl        String?
  imagePublicId   String?
  isRead          Boolean   @default(false)
  hiddenByTeacher Boolean   @default(false)
  hiddenByStudent Boolean   @default(false)
  createdAt       DateTime  @default(now())

  chatRoom ChatRoom @relation(fields: [chatRoomId], references: [id], onDelete: Cascade)
  sender   User     @relation("UserMessages", fields: [senderId], references: [id], onDelete: Cascade)
}

model Notification {
  id        Int              @id @default(autoincrement())
  userId    Int
  title     String
  type      NotificationType
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model QuizScore {
  id             Int      @id @default(autoincrement())
  studentId      Int
  score          Int
  totalQuestions Int      @default(10)
  createdAt      DateTime @default(now())
  student        User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
}